# ─────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# The .env file is git-ignored — never commit secrets.
# ─────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────
POSTGRES_DB=ems_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST_PORT=5432

# ── ASP.NET Core API ────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
API_HOST_PORT=8080

# ── JWT ─────────────────────────────────────────────
# Must be at least 32 characters long
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET
JWT_ISSUER=EmployeeManagement.Api
JWT_AUDIENCE=EmployeeManagement.Client
JWT_EXPIRATION_MINUTES=60

# ── CORS (comma-separated frontend origins) ──────────
CORS_ORIGIN_0=http://localhost:3000
CORS_ORIGIN_1=http://localhost:5173
