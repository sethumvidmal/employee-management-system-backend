# ─────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# The .env file is git-ignored — never commit secrets.
# ─────────────────────────────────────────────────────

# ── MariaDB (installed on the host, not in Docker) ──
# The API container uses host networking, so 127.0.0.1 is the host itself.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ems_db
DB_USER=ems_user
# Avoid ; ' " and $ in the password (they break the connection string / compose interpolation)
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Your MariaDB version — check with:  mariadb --version
# Ubuntu 22.04 ships 10.6, Ubuntu 24.04 ships 10.11
DB_SERVER_VERSION=10.6.0-mariadb

# ── ASP.NET Core API ────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
# 127.0.0.1 = only reachable through the nginx reverse proxy (recommended).
# Use 0.0.0.0 to expose the API port directly.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080

# ── JWT ─────────────────────────────────────────────
# Must be at least 32 characters long. Generate one with:  openssl rand -base64 48
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET
JWT_ISSUER=EmployeeManagement.Api
JWT_AUDIENCE=EmployeeManagement.Client
JWT_EXPIRATION_MINUTES=60

# ── CORS (allowed frontend origins) ─────────────────
CORS_ORIGIN_0=http://localhost:3000
CORS_ORIGIN_1=http://localhost:5173
CORS_ORIGIN_2=https://employee-management-syst-1ce7e.web.app
CORS_ORIGIN_3=https://employee-management-syst-1ce7e.firebaseapp.com
